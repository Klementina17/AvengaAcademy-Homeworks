@using VideoRentalOnlineShopApp.Domain.Enums
@model IEnumerable<MoviesVM>


<div class="container mt-2">
<div class="row">
        <h2 class="mb-4 text-center">Movies</h2>
    <div class="col-md-12">
        <form method="get" asp-action="GetAllMovies" class="mb-3 d-flex float-end gap-2">
            <input type="text"
                   name="search"
                   value="@ViewBag.SearchBy"
                   class="form-control"
                   placeholder="Search by title..."/>

            <select name="genre" class="form-select" onchange="this.form.submit()">
                <option value="">Select Genre</option>
                @foreach (var genre in Enum.GetValues<Genre>())
                {
                    <option value="@genre" selected="@(ViewBag.SelectedGenre?.Equals(genre) == true)">
                        @genre
                    </option>
                }
            </select>

            @if(string.IsNullOrWhiteSpace(ViewBag.SearchBy as string)){
            <button class="btn btn-primary" type="submit">Search</button>
            }
            else{
                <a class="btn btn-danger" asp-action="GetAllMovies" >Clear</a>
            }
       
        </form>
    </div>
    <div class="col-md-12">
        <table class="table table-striped table-bordered table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Genre</th>
                    <th>Language</th>
                    @* <th>Release Date</th> *@
                    <th>Length</th>
                    <th>Available</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var movie in Model)
                {
                    <tr class="@(movie.IsAvailable ? "" : "table-secondary text-muted")">
                        <td>@movie.Title</td>
                        <td>@movie.Genre</td>
                        <td>@movie.Language</td>
                        <td>@movie.Length</td>

                        <td>
                            @if (movie.IsAvailable)
                            {
                                <span class="badge bg-success p-2">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger p-2">No</span>
                            }
                        </td>

                        <td>
                            <a class="btn btn-primary btn-sm" asp-action="MovieDetails" asp-route-id="@movie.Id">Open</a>

                            @if (movie.IsAvailable)
                            {
                                <a class="btn btn-warning btn-sm" asp-controller="Rental" asp-action="RentMovie" asp-route-id="@movie.Id">Rent</a>
                                @* <button class="btn btn-warning btn-sm">Rent</button> *@
                            }
                            else
                            {
                                <form asp-controller="Rental" asp-action="ReturnMovieByMovieId" asp-route-movieId="@movie.Id" method="post">
                                    <button type="submit" class="btn btn-success btn-sm">Return</button>
                                </form>

                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>
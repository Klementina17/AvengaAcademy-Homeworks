@model IEnumerable<RentalVM>

<h2>Currently Rented Movies</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Movie</th>
            <th>User</th>
            <th>Rented On</th>
            <th>Returned On</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rental in Model.Where(r => r.ReturnedOn == null))
        {
            <tr>
                <td>@rental.MovieName</td>
                <td>@rental.UserName</td>
                <td>@rental.RentedOn</td>
                <td>Not returned</td>
                <td>
                    <form asp-controller="Rental" asp-action="ReturnMovie" asp-route-id="@rental.Id" method="post">
                        <button type="submit" class="btn btn-success btn-sm">Return</button>
                    </form>
                </td>
            </tr>
        }
        <a asp-controller="Movie" asp-action="GetAllMovies" class="btn btn-primary">Back to Movies</a>
    </tbody>
</table>